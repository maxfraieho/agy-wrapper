#!/usr/bin/env python3
"""AGY — unified LLM wrapper for OpenDesign (streamFormat: plain).

Sources (priority order):
  1. AGY3 tablet                   http://192.168.3.162:8080
  2. AGY phone                     http://192.168.3.25:8080
  3. local free-claude-code-proxy  http://172.17.0.1:18880  (slots)

Automatically falls back to next endpoint on 503 (no upstream configured).
OpenDesign agent: antigravity | bin: agy | streamFormat: plain
"""
import json
import os
import socket
import sys
import urllib.error
import urllib.request

VERSION = "1.2.0"
LOCAL_TOKEN = os.environ.get("LOCAL_PROXY_TOKEN", "freecc")
AGY_TOKEN   = os.environ.get("AGY_API_KEY", "proxy-key")

LOCAL_SLOTS = [
    "standard-proxy", "coding-proxy", "agent-proxy", "reasoning-proxy",
    "analytics-proxy", "multimedia-proxy", "fast-proxy", "cheap-proxy",
    "docs-assistant-proxy",
]
AGY_MODELS = [
    "gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.5-flash-thinking",
    "gemini-2.5-flash-lite", "gemini-3-flash", "gemini-3-flash-agent",
    "gemini-3.1-flash-lite", "gemini-3.1-flash-image",
    "gemini-3.1-pro-high", "gemini-3.1-pro-low",
    "gemini-3.5-flash-low", "gemini-3.5-flash-medium", "gemini-3.5-flash-extra-low",
    "gemini-pro-agent", "claude-sonnet-4-6", "claude-opus-4-6-thinking",
]
ENDPOINTS = [
    {"name": "agy3",      "base": "http://192.168.3.162:8080","token": AGY_TOKEN,   "models": AGY_MODELS},
    {"name": "agy-phone", "base": "http://192.168.3.25:8080", "token": AGY_TOKEN,   "models": AGY_MODELS},
    {"name": "local",     "base": "http://172.17.0.1:18880",  "token": LOCAL_TOKEN, "models": LOCAL_SLOTS},
]
DISPLAY_TO_ID = {
    "default":                       "gemini-2.5-flash",
    "Gemini 3.1 Pro (High)":        "gemini-3.1-pro-high",
    "Gemini 3.1 Pro (Low)":         "gemini-3.1-pro-low",
    "Gemini 3.5 Flash (High)":      "gemini-pro-agent",
    "Gemini 3.5 Flash (Medium)":    "gemini-3.5-flash-medium",
    "Gemini 3.5 Flash (Low)":       "gemini-3.5-flash-low",
    "Claude Sonnet 4.6 (Thinking)": "claude-sonnet-4-6",
    "Claude Opus 4.6 (Thinking)":   "claude-opus-4-6-thinking",
    "GPT-OSS 120B (Medium)":        "standard-proxy",
}


def is_reachable(base: str, timeout: float = 2.0) -> bool:
    try:
        from urllib.parse import urlparse
        p = urlparse(base)
        with socket.create_connection((p.hostname, p.port or 80), timeout=timeout):
            return True
    except OSError:
        return False


def candidate_endpoints(model_id: str):
    """Yield (model_id, endpoint) pairs in priority order."""
    seen = set()
    for ep in ENDPOINTS:
        if model_id in ep["models"] and is_reachable(ep["base"]):
            seen.add(ep["name"])
            yield model_id, ep
    for ep in ENDPOINTS:
        if ep["name"] not in seen and is_reachable(ep["base"]):
            yield ep["models"][0], ep


def stream_chat(ep: dict, model: str, prompt: str) -> bool:
    """Stream response. Returns True on success, False on 503/unreachable (retry)."""
    payload = json.dumps({
        "model":    model,
        "stream":   True,
        "messages": [{"role": "user", "content": prompt}],
    }).encode()
    req = urllib.request.Request(
        ep["base"] + "/v1/chat/completions",
        data=payload,
        headers={
            "Content-Type":  "application/json",
            "Authorization": "Bearer " + ep["token"],
            "x-api-key":     ep["token"],
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw in resp:
                line = raw.decode("utf-8", errors="replace").rstrip()
                if not line.startswith("data: "):
                    continue
                chunk = line[6:]
                if chunk == "[DONE]":
                    break
                try:
                    text = (json.loads(chunk).get("choices") or [{}])[0].get("delta", {}).get("content", "")
                    if text:
                        sys.stdout.write(text)
                        sys.stdout.flush()
                except Exception:
                    pass
        return True
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")[:300]
        if e.code == 503:
            sys.stderr.write("[agy] " + ep["name"] + " 503 (no upstream) — trying next\n")
            return False
        sys.stderr.write("agy: HTTP " + str(e.code) + " (" + ep["name"] + "): " + body + "\n")
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.stderr.write("[agy] " + ep["name"] + " unreachable — trying next\n")
        return False


def main() -> None:
    args = sys.argv[1:]
    if "--version" in args or "-v" in args:
        print("agy " + VERSION + " (local-proxy + AGY3 + AGY-phone, auto-fallback)")
        return
    model_raw, i = "default", 0
    while i < len(args):
        if args[i] in ("--model", "-m") and i + 1 < len(args):
            model_raw = args[i + 1]
            i += 2
        else:
            i += 1
    prompt = sys.stdin.read().strip()
    if not prompt:
        sys.exit(0)
    model_id = DISPLAY_TO_ID.get(model_raw, model_raw)
    for mid, ep in candidate_endpoints(model_id):
        sys.stderr.write("[agy] -> " + ep["name"] + " | model=" + mid + "\n")
        if stream_chat(ep, mid, prompt):
            return
    sys.stderr.write("agy: all endpoints failed\n")
    sys.exit(1)


if __name__ == "__main__":
    main()
